cmake_minimum_required(VERSION 3.15)

# Keep captures after the test so a reviewer can inspect the complete pipeline,
# including the diagnostics from intentionally invalid source files.
set(review_directory "${CMAKE_CURRENT_BINARY_DIR}/phase1-review")
set(input_directory "${review_directory}/generated-inputs")
file(MAKE_DIRECTORY "${input_directory}")
set(summary "${review_directory}/summary.md")
file(WRITE "${summary}" "# Phase-one pipeline review\n\nGenerated by the phase1_pipeline_cli CTest.\n\nExpected errors are successful test cases when the status and diagnostics match.\n\n| Case | Lexical errors | Syntax errors | Source | Tokens | AST | Classify | ANSI | HTML |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n")

function(expected_html_text source_hex result_name)
    # file(READ ... HEX) avoids CMake's text newline conversion. Build the
    # expected escaped text from the actual fixture bytes, independently of the
    # compiler's loader/lexer/parser, including every original CR and LF.
    string(LENGTH "${source_hex}" hex_length)
    set(expected "")
    if(hex_length GREATER 0)
        math(EXPR last_byte "${hex_length} - 2")
        foreach(offset RANGE 0 ${last_byte} 2)
            string(SUBSTRING "${source_hex}" ${offset} 2 byte_hex)
            math(EXPR byte "0x${byte_hex}")
            if(byte EQUAL 38)
                string(APPEND expected "&amp;")
            elseif(byte EQUAL 60)
                string(APPEND expected "&lt;")
            elseif(byte EQUAL 62)
                string(APPEND expected "&gt;")
            elseif(byte EQUAL 34)
                string(APPEND expected "&quot;")
            elseif(byte EQUAL 39)
                string(APPEND expected "&#39;")
            elseif(byte EQUAL 13)
                string(APPEND expected "&#13;")
            elseif(byte EQUAL 9 OR byte EQUAL 10 OR (byte GREATER_EQUAL 32 AND byte LESS 127))
                string(ASCII ${byte} character)
                string(APPEND expected "${character}")
            else()
                message(FATAL_ERROR "Pipeline text fixtures must be ASCII with tabs/line endings")
            endif()
        endforeach()
    endif()
    set(${result_name} "${expected}" PARENT_SCOPE)
endfunction()

function(check_case case_name source_file lexical_count syntax_count syntax_code)
    set(case_directory "${review_directory}/${case_name}")
    file(MAKE_DIRECTORY "${case_directory}")
    get_filename_component(source_name "${source_file}" NAME)
    configure_file("${source_file}" "${case_directory}/${source_name}" COPYONLY)
    file(READ "${source_file}" source_hex HEX)
    file(SIZE "${source_file}" source_size)
    expected_html_text("${source_hex}" expected_markup)
    math(EXPR analysis_count "${lexical_count} + ${syntax_count}")
    set(reference_diagnostics "")
    set(status_cells "")

    foreach(mode IN ITEMS source tokens ast classify ansi html)
        set(options "")
        set(expected_exit 0)
        set(expected_count 0)
        if(NOT mode STREQUAL "source")
            list(APPEND options "--${mode}")
            set(expected_count ${analysis_count})
            if(mode STREQUAL "tokens")
                set(expected_count ${lexical_count})
            endif()
            if(expected_count GREATER 0)
                set(expected_exit 1)
            endif()
        endif()
        if(mode STREQUAL "tokens" OR mode STREQUAL "classify")
            list(APPEND options --show-whitespace)
        endif()
        # Each process gets a timeout. -- is essential for the generated source
        # whose name begins with a dash; spaces stay inside the single argument.
        set(capture "${case_directory}/${mode}.out")
        if(mode STREQUAL "html")
            set(capture "${case_directory}/highlighted.html")
        elseif(mode STREQUAL "ansi")
            set(capture "${case_directory}/terminal.ansi")
        endif()
        execute_process(
            COMMAND "${PROGRAM}" ${options} -- "${source_name}"
            WORKING_DIRECTORY "${case_directory}"
            RESULT_VARIABLE exit_code
            OUTPUT_FILE "${capture}"
            ERROR_FILE "${case_directory}/${mode}.err"
            TIMEOUT 10
        )
        file(READ "${capture}" output)
        file(READ "${case_directory}/${mode}.err" diagnostics)
        string(REGEX MATCHALL "error \\[(LEX|PAR)[0-9]+\\]" errors "${diagnostics}")
        list(LENGTH errors actual_count)
        if(NOT exit_code STREQUAL "${expected_exit}" OR NOT actual_count EQUAL expected_count)
            message(FATAL_ERROR "${case_name}/${mode}: expected status ${expected_exit} and ${expected_count} errors, got ${exit_code} and ${actual_count}. See ${case_directory}")
        endif()
        if(expected_count EQUAL 0 AND NOT diagnostics STREQUAL "")
            message(FATAL_ERROR "${case_name}/${mode}: unexpected stderr: ${diagnostics}")
        endif()
        if(mode STREQUAL "source")
            if(NOT output MATCHES "^Loaded:" OR NOT output MATCHES "Bytes: ${source_size}")
                message(FATAL_ERROR "${case_name}: source-display mode lost its byte summary")
            endif()
        elseif(mode STREQUAL "tokens")
            if(NOT output MATCHES "^Location" OR NOT output MATCHES "\tEOF\t\"\"")
                message(FATAL_ERROR "${case_name}: token output is incomplete")
            endif()
            if(lexical_count GREATER 0 AND NOT output MATCHES "\tINVALID\t")
                message(FATAL_ERROR "${case_name}: lexical errors lost their INVALID tokens")
            endif()
        elseif(mode STREQUAL "ast")
            # Lexical errors intentionally prevent AST startup. Clean lexing
            # still permits a recovered tree when syntax diagnostics exist.
            if(lexical_count GREATER 0)
                if(NOT output STREQUAL "" OR diagnostics MATCHES "error \\[PAR")
                    message(FATAL_ERROR "${case_name}: AST lexical gating regressed")
                endif()
            elseif(NOT output MATCHES "^Program" OR (syntax_count GREATER 0 AND NOT output MATCHES "Error(Decl|Stmt)"))
                message(FATAL_ERROR "${case_name}: missing complete/recovered AST")
            endif()
            if(syntax_count GREATER 0 AND NOT diagnostics MATCHES "error \\[${syntax_code}\\]")
                message(FATAL_ERROR "${case_name}: wrong parser diagnostic category")
            endif()
            set(reference_diagnostics "${diagnostics}")
        else()
            if(NOT diagnostics STREQUAL reference_diagnostics)
                message(FATAL_ERROR "${case_name}/${mode}: analysis diagnostics differ from AST mode")
            endif()
            if(mode STREQUAL "classify")
                if(NOT output MATCHES "^Location\tOffset\tLength\tRole\tError\tLexeme")
                    message(FATAL_ERROR "${case_name}: classification table is missing")
                endif()
            elseif(mode STREQUAL "ansi")
                # Compare bytes, not text read through CMake or a shell. These
                # fixtures contain no source-authored terminal escapes.
                file(READ "${capture}" ansi_hex HEX)
                string(REGEX REPLACE "1b5b(3[0-9]|3b)*6d" "" plain_hex "${ansi_hex}")
                if(NOT plain_hex STREQUAL source_hex)
                    message(FATAL_ERROR "${case_name}: ANSI changed source bytes")
                endif()
            elseif(mode STREQUAL "html")
                set(opening "<code id=\"source\">")
                string(FIND "${output}" "${opening}" code_start)
                string(FIND "${output}" "</code>" code_end)
                if(code_start LESS 0 OR code_end LESS code_start OR NOT output MATCHES "</html>")
                    message(FATAL_ERROR "${case_name}: incomplete HTML document")
                endif()
                string(LENGTH "${opening}" opening_length)
                math(EXPR code_start "${code_start} + ${opening_length}")
                math(EXPR code_length "${code_end} - ${code_start}")
                string(SUBSTRING "${output}" ${code_start} ${code_length} markup)
                string(REGEX REPLACE "<span class=\"[a-z -]+\">|</span>" "" plain_markup "${markup}")
                if(NOT plain_markup STREQUAL expected_markup)
                    message(FATAL_ERROR "${case_name}: HTML changed escaped source/formatting")
                endif()
                if(analysis_count GREATER 0 AND NOT markup MATCHES "class=\"[a-z -]+ error\"")
                    message(FATAL_ERROR "${case_name}: recovered HTML lost error decoration")
                endif()
            endif()
        endif()
        string(APPEND status_cells " ${exit_code} |")
    endforeach()

    file(READ "${case_directory}/${source_name}" unchanged_hex HEX)
    if(NOT unchanged_hex STREQUAL source_hex)
        message(FATAL_ERROR "${case_name}: an output mode modified its source file")
    endif()
    file(APPEND "${summary}" "| [${case_name}](${case_name}/highlighted.html) | ${lexical_count} | ${syntax_count} |${status_cells}\n")
endfunction()

set(valid_samples hello lexer_full declarations expressions statements classification html_preview)
foreach(sample IN LISTS valid_samples)
    check_case("${sample}" "${EXAMPLES}/${sample}.bminor" 0 0 PAR001)
endforeach()
foreach(sample IN ITEMS declaration_error expression_error statement_error tokens_basic)
    check_case("${sample}" "${EXAMPLES}/${sample}.bminor" 0 1 PAR001)
endforeach()
check_case(syntax_errors "${EXAMPLES}/syntax_errors.bminor" 0 5 PAR001)
check_case(lexical_errors "${EXAMPLES}/lexical_errors.bminor" 6 0 PAR001)

file(WRITE "${input_directory}/empty.bminor" "")
file(WRITE "${input_directory}/whitespace.bminor" " \t\r  ")
check_case(empty "${input_directory}/empty.bminor" 0 0 PAR001)
check_case(whitespace "${input_directory}/whitespace.bminor" 0 0 PAR001)

# configure_file's explicit newline style produces true CRLF on every platform;
# writing literal CRLF in text mode could double the CR on Windows.
file(WRITE "${input_directory}/template.bminor" "\n/* first\n\tsecond */\nvalue: integer = 1;  \n")
configure_file("${input_directory}/template.bminor" "${input_directory}/line endings with spaces.bminor" @ONLY NEWLINE_STYLE CRLF)
file(READ "${input_directory}/line endings with spaces.bminor" crlf_hex HEX)
if(NOT crlf_hex MATCHES "0d0a" OR crlf_hex MATCHES "0d0d0a")
    message(FATAL_ERROR "The CRLF fixture was not generated correctly")
endif()
check_case(crlf "${input_directory}/line endings with spaces.bminor" 0 0 PAR001)

file(WRITE "${input_directory}/-leading dash.bminor" "value:\tinteger = 42;")
check_case(dash_path_no_final_newline "${input_directory}/-leading dash.bminor" 0 0 PAR001)

string(REPEAT "(" 140 opening_groups)
string(REPEAT ")" 140 closing_groups)
file(WRITE "${input_directory}/depth.bminor" "broken: integer = ${opening_groups}1${closing_groups};\nafter: integer = 42;\n")
check_case(depth_limit "${input_directory}/depth.bminor" 0 1 PAR003)
file(READ "${review_directory}/depth_limit/ast.out" recovered_depth)
if(NOT recovered_depth MATCHES "Identifier \"after\"")
    message(FATAL_ERROR "Resource-limit recovery lost the following declaration")
endif()

string(REPEAT "    print 1;\n" 400 wide_statements)
file(WRITE "${input_directory}/wide.bminor" "main: function integer () = {\n${wide_statements}    return 0;\n}\n")
check_case(wide_program "${input_directory}/wide.bminor" 0 0 PAR001)

file(APPEND "${summary}" "\n**PASS: 19 cases, 114 native CLI runs.**\n\nEach case directory contains its original input, source/token/AST/classification output, a raw ANSI file, highlighted HTML and a separate stderr file per mode.\n")
message(STATUS "Pipeline review passed: 19 cases, 114 CLI runs. Captures: ${review_directory}")
